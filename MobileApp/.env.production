# Mobile App Production Environment
NODE_ENV=production

# API Configuration
DEV_API_URL=http://localhost:8000/api
PROD_API_URL=https://api.gisconnect.online/api
STAGING_API_URL=https://staging-api.gisconnect.online/api
FALLBACK_API_URL=https://server.gisconnect.online/api

# Cloudflare Configuration
CLOUDFLARE_ENABLED=true
CLOUDFLARE_DOMAIN=gisconnect.online
SYNC_ENABLED=true
SYNC_INTERVAL=300000

# Google Maps
GOOGLE_MAPS_API_KEY=

# Build Configuration
EXPO_PUBLIC_API_URL=https://api.gisconnect.online/api
EXPO_PUBLIC_WEBSOCKET_URL=wss://server.gisconnect.online
EXPO_PUBLIC_DASHBOARD_URL=https://dashboard.gisconnect.online
EXPO_PUBLIC_CLOUDFLARE_ENABLED=true
EXPO_PUBLIC_REALTIME_ENABLED=true
EXPO_PUBLIC_MONITORING_ENABLED=true
