
# Production Environment Configuration
NODE_ENV=production
PORT=8000
HTTPS_PORT=8443

# CORS Configuration
CORS_ORIGIN=http://localhost:4173,https://dashboard.gisconnect.online

# Database Configuration
DB_PATH=./database/production.db
DB_BACKUP_PATH=./backups/
DB_SYNC_INTERVAL=60000

# JWT Configuration
JWT_SECRET=gis2026-secure-jwt-secret-key-production
TOKEN_EXPIRY=24h

# Cloudflare Configuration
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_KV_NAMESPACE=af106ee16e7941f6a706a004410db88e

# Domain Configuration
DOMAIN=gisconnect.online
DASHBOARD_SUBDOMAIN=dashboard
API_SUBDOMAIN=api
SERVER_SUBDOMAIN=server

# SSL Configuration
SSL_CERT_PATH=./ssl/server.crt
SSL_KEY_PATH=./ssl/server.key

# Real-time Configuration
SOCKET_CORS_ORIGIN=https://dashboard.gisconnect.online
REALTIME_SYNC_ENABLED=true
SYNC_BATCH_SIZE=100

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/server.log

# Monitoring
MONITORING_ENABLED=true
HEALTH_CHECK_INTERVAL=30000
