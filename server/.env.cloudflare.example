# Cloudflare Configuration
# ========================

# Enable/Disable Cloudflare integration
CLOUDFLARE_ENABLED=true

# Cloudflare API Token (Generate from Cloudflare Dashboard)
# https://dash.cloudflare.com/?to=/:account/profile/api-tokens
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Cloudflare Account ID
# Found in Cloudflare Dashboard URL: dash.cloudflare.com/YOUR_ACCOUNT_ID
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# Cloudflare KV Namespace ID
# Created in Cloudflare Workers > KV
CLOUDFLARE_KV_NAMESPACE_ID=your_kv_namespace_id_here

# Domain configuration
CLOUDFLARE_DOMAIN=yourdomain.com

# Cache configuration
CLOUDFLARE_CACHE_TTL_STATIC=2592000
CLOUDFLARE_CACHE_TTL_API=300
CLOUDFLARE_CACHE_TTL_HEALTH=60

# Sync configuration
SYNC_SECRET=your_sync_secret_key_here
