{
  "helmet": {
    "contentSecurityPolicy": {
      "directives": {
        "defaultSrc": [
          "'self'"
        ],
        "styleSrc": [
          "'self'",
          "'unsafe-inline'",
          "https://fonts.googleapis.com"
        ],
        "fontSrc": [
          "'self'",
          "https://fonts.gstatic.com"
        ],
        "imgSrc": [
          "'self'",
          "data:",
          "https:"
        ],
        "scriptSrc": [
          "'self'"
        ],
        "connectSrc": [
          "'self'",
          "wss:",
          "https:"
        ]
      }
    }
  },
  "rateLimit": {
    "windowMs": 900000,
    "max": 100
  },
  "cors": {
    "origin": "https://dashboard.gisconnect.online",
    "credentials": true
  }
}