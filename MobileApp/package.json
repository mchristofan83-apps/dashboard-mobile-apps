{
  "name": "dashboard-mobile-app",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android-apk": "eas build --platform android --profile preview",
    "build:android-aab": "eas build --platform android --profile production",
    "build:ios": "eas build --platform ios --profile production",
    "build:all": "npm run build:android && npm run build:ios",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "build:list": "eas build:list",
    "build:logs": "eas build:log",
    "build:android": "eas build --platform android --profile production",
    "build:android:apk": "eas build --platform android --profile preview",
    "build:ios:simulator": "eas build --platform ios --profile preview",
    "build:preview": "npm run build:android:apk && npm run build:ios:simulator"
  },
  "dependencies": {
    "@expo/config-plugins": "~7.8.0",
    "@react-native-async-storage/async-storage": "1.18.2",
    "@react-navigation/bottom-tabs": "6.5.11",
    "@react-navigation/native": "6.1.9",
    "@react-navigation/stack": "6.3.20",
    "axios": "^1.13.3",
    "expo": "~54.0.30",
    "expo-camera": "13.4.4",
    "expo-constants": "14.4.2",
    "expo-image-picker": "14.7.0",
    "expo-location": "16.1.0",
    "expo-notifications": "^0.32.16",
    "expo-secure-store": "^15.0.8",
    "expo-sqlite": "^16.0.10",
    "expo-status-bar": "1.6.0",
    "react": "18.2.0",
    "react-native": "0.72.17",
    "react-native-safe-area-context": "4.6.3",
    "react-native-screens": "3.22.0",
    "socket.io-client": "^4.8.3",
    "vexo-analytics": "^1.5.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "^19.2.9",
    "babel-preset-expo": "~9.5.0",
    "typescript": "^5.9.3"
  },
  "private": true
}
